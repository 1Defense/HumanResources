[Unit]
Description=SinIceStir anonymous suggestion box backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=work
Group=work
WorkingDirectory=/home/work/suggestion-box
ExecStart=/usr/bin/python3 /home/work/suggestion-box/server.py
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/work/suggestion-box
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
